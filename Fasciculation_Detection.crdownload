      "    outer 30/50: sigma_n=0.119058, mse=1.418255e-02, elbo=-7816.8282\n",
      "    outer 35/50: sigma_n=0.118559, mse=1.416744e-02, elbo=-7874.3370\n",
      "    outer 40/50: sigma_n=0.118656, mse=1.408916e-02, elbo=-7818.0143\n",
      "    outer 45/50: sigma_n=0.118844, mse=1.414835e-02, elbo=-7825.9918\n",
